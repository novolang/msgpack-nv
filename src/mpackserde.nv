// mpackserde — the bridge to the standard library's serialization
// traits, so a novo-lang struct writes and reads itself as MessagePack.
//
// Both halves can be written, because MessagePack is self-describing.
// A reader's `field` scans the map at its own offset for the key and
// answers a reader at the value, so the parent never has to be
// advanced.  `nil` is a format byte of its own, so `None` is
// `put_null` and `Some(x)` is `x`, and the two are already different
// documents.
//
// Where it is short of the format, the value tree in `mpack` is the
// answer: the trait has one integer hook, so `uint 64` above 2^63 is
// unreachable; one float hook, so everything goes out as `float 64`; no
// bytes hook, so the `bin` family is unreachable; and no way to open a
// map whose keys are not strings.
//
// The writer builds its document as a list of byte values.  Each
// method answers a new writer holding the old list and what it wrote,
// because a `Serializer` is threaded rather than written in place.

use mpack

// A MessagePack document being built.
//
// `out` accumulates byte values because a `Serializer` is threaded
// rather than mutated — every method takes the writer and returns it —
// and because the runtime's `Bytes` cannot be appended to element by
// element.  A caller who needs the finished bytes calls `writer_bytes`.
//
// `depth` is how many structs and sequences are open.  A type nested
// past the decoder's limit is refused by `to_bytes`, which reads its
// own document back with the decoder's limit, so the writer never
// answers a document nothing can read.
pub struct MsgWriter
    out: [Int]
    depth: Int

// A cursor into a MessagePack document: an offset, not a parsed tree.
//
// `at` is the byte the next read starts at and `path` is the route from
// the document's root, which `DeserializeError` needs.  Unlike a
// nameless format's reader, this one does not need the walk to thread
// its position: every member is found by scanning the map at `at` for
// its key, so the parent stays exactly where it was and answers the
// same question again for the next member.
//
// That is the whole reason this impl can be written and postcard's
// cannot, and it is why the field is called `at` and never moves.
pub struct MsgReader
    src: Bytes
    at: Int
    path: Str

// A fresh writer with nothing in it.
pub fn writer() -> MsgWriter
    MsgWriter { out: [], depth: 0 }

// The bytes a writer accumulated.
//
// Cannot fail: everything the `Serializer` trait can present has a
// MessagePack encoding, which is the difference from postcard-nv's
// `writer_bytes` and the reason this one answers `Bytes` rather than a
// `Result`.
pub fn writer_bytes(w: MsgWriter) -> Bytes
    bytes.from_byte_list(w.out)

// A fresh reader over `src`, positioned at the document's root.
pub fn reader(src: Bytes) -> MsgReader
    MsgReader { src: src, at: 0, path: "$" }

// The byte offset `r` reads from.
//
// A caller reading a stream of documents out of one buffer uses it to
// find the next one; a caller reading one document uses `mpack.decode`
// and never needs it.
pub fn reader_at(r: MsgReader) -> Int
    r.at

// The format side, so a novo-lang struct or enum writes itself.
//
// A struct becomes a `map` whose keys are the member names, which is
// what every other MessagePack binding for a statically typed language
// does and what makes the output readable by a Python or Ruby peer that
// has never seen the type.
//
// The alternative — a struct as an `array` of its members in
// declaration order — is half the bytes and is what a schema-sharing
// pair of novo-lang programs would rather have.  It is deliberately not
// what this does: the trait gives `begin_struct` the member count but
// gives the reader no way to know which convention the writer chose, so
// a package that had both would produce documents that decode as the
// wrong shape with no diagnostic.  A caller who wants the array form
// builds a `MsgArray` in `mpack`.
impl Serializer for MsgWriter
    // `0xc0`.  The whole of MessagePack's optional handling on the
    // write side, because `Some(x)` is `x`.
    fn put_null(self) -> MsgWriter
        wrote(self, [0xC0])

    fn put_bool(self, v: Bool) -> MsgWriter
        wrote(self, [(if v then 0xC3 else 0xC2)])

    // The shortest format that holds `v`: a positive fixint for
    // `0 ..= 127`, a negative fixint for `-32 ..= -1`, then `uint 8` to
    // `uint 64` for a positive value and `int 8` to `int 64` for a
    // negative one, as `mpack.encode` writes `MsgInt`.
    //
    // `uint 64` above 2^63 is unreachable from here — there is one
    // integer hook and novo-lang has one integer type — so a document
    // with such a value in it is built with `mpack`'s `MsgUint`.
    fn put_int(self, v: Int) -> MsgWriter
        wrote(self, encoded(MsgInt(v)))

    // `0xcb`, `float 64`, always.
    //
    // The trait has one float hook and novo-lang has one float type, so
    // there is nothing here to decide with: a caller who wants the
    // four-byte `float 32` builds a `MsgFloat32` in `mpack`.
    fn put_float(self, v: Float) -> MsgWriter
        wrote(self, encoded(MsgFloat64(v)))

    // The shortest `str` format that holds `v`.
    //
    // Note what is not here: a hook for `Bytes`.  The `bin` family is
    // unreachable through this trait, so a member that is really bytes
    // travels as a `str` of whatever the caller encoded it to — base64,
    // hex — or the document is built with `mpack`'s `MsgBin`.
    fn put_str(self, v: Str) -> MsgWriter
        wrote(self, encoded(MsgStr(v)))

    // The `map` header for `n` members.  `name` is not written: a
    // MessagePack map has no type tag, and a reader that wanted one
    // would be reading a different format.
    fn begin_struct(self, name: Str, n: Int) -> MsgWriter
        deeper(wrote(self, header(n, 0x80, 0xDE)), 1)

    // The member's name, as a `str` key.  The value the walk writes
    // next is the entry's value.
    fn field(self, name: Str) -> MsgWriter
        wrote(self, encoded(MsgStr(name)))

    // Nothing: the header already said how many entries there were, so
    // a MessagePack map has no terminator.
    fn end_struct(self) -> MsgWriter
        deeper(self, -1)

    // The `array` header for `n` elements.
    fn begin_seq(self, n: Int) -> MsgWriter
        deeper(wrote(self, header(n, 0x90, 0xDC)), 1)

    // Nothing: elements are told apart by position, and the header
    // said how many there are.
    fn elem(self) -> MsgWriter
        self

    fn end_seq(self) -> MsgWriter
        deeper(self, -1)

    // Nothing.  The standard library's walk writes an enum value as a
    // one-entry `map` from the variant name to its payload, the
    // externally tagged form, with the calls above, and reads it back
    // the same way.
    //
    // `index` is ignored on purpose.  A variant index is two bytes
    // cheaper and is what postcard writes, and it is also what turns
    // reordering an enum's variants into a silent wire-compatibility
    // break.  A self-describing format can afford the name, so it
    // spends it.
    fn begin_variant(self, enum_name: Str, variant: Str, index: Int, n: Int) -> MsgWriter
        self

    fn end_variant(self) -> MsgWriter
        self

// The cursor side, so a novo-lang struct or enum reads itself.
//
// Every method is writable today.  `field` scans the map at `at` for
// the key and answers a reader positioned at its value; the parent is
// unchanged and is asked again for the next member, which is exactly
// what a self-describing format makes possible and a nameless one does
// not.
impl Deserializer for MsgReader
    // The member named `name`, or a `DeserializeError` whose path says
    // where it was looked for.
    //
    // Scans the map at `at` and does not advance the parent.  The scan
    // is why a struct of `n` members costs O(n^2) key comparisons; for
    // the member counts a struct actually has, that is cheaper than the
    // index it would take to avoid it.
    fn field(self, name: Str) -> Result<MsgReader, DeserializeError>
        match member_at(self.src, self.at, name)
            Some(at) => Ok(MsgReader { src: self.src, at: at, path: self.path + "." + name })
            None     => Err(DeserializeError { path: self.path, reason: "no member named ${name}" })

    // The member named `name` when it is present and not `nil`.
    //
    // A missing key and a key whose value is `0xc0` are the same
    // answer, which is the convention every MessagePack binding uses
    // and the one that lets a writer drop `None` members without
    // changing what a reader sees.
    fn opt_field(self, name: Str) -> ?MsgReader
        match member_at(self.src, self.at, name)
            None     => None
            Some(at) =>
                if byte(self.src, at) == 0xC0
                    return None
                Some(MsgReader { src: self.src, at: at, path: self.path + "." + name })

    // The keys of the map at `at`, in document order.
    //
    // Unlike postcard-nv's, this one answers something: the wire
    // carries the names.  It is what the standard library's externally
    // tagged enum reader uses to find the variant name.
    fn keys(self) -> [Str]
        let count = map_count(self.src, self.at)
        var out: [Str] = []
        var at = map_body(self.src, self.at)
        for _ in 0..count
            if let Some(MsgStr(k)) = value_at(self.src, at)
                list.push(out, k)
            at = skip(self.src, skip(self.src, at))
        out

    fn seq_len(self) -> Result<Int, DeserializeError>
        let tag = byte(self.src, self.at)
        if tag >= 0x90 and tag <= 0x9F or tag == 0xDC or tag == 0xDD
            return Ok(seq_count(self.src, self.at))
        Err(DeserializeError { path: self.path, reason: "expected an array" })

    // Element `i`, found by skipping elements 0 through `i - 1`.
    //
    // MessagePack writes no offsets either, so this re-scans exactly as
    // postcard's does and a walk over every element costs O(n^2).  The
    // difference is that skipping a MessagePack element needs only its
    // format byte, so the scan is a header walk rather than a decode.
    fn seq_at(self, i: Int) -> Result<MsgReader, DeserializeError>
        match self.seq_len()
            Err(e) => Err(e)
            Ok(n)  =>
                if i < 0 or i >= n
                    return Err(DeserializeError { path: self.path, reason: "no element ${i} of ${n}" })
                var at = seq_body(self.src, self.at)
                for _ in 0..i
                    at = skip(self.src, at)
                Ok(MsgReader { src: self.src, at: at, path: self.path + "[${i}]" })

    // Whether the value at `at` is `0xc0`.
    fn is_null(self) -> Bool
        byte(self.src, self.at) == 0xC0

    fn get_bool(self) -> Result<Bool, DeserializeError>
        match value_at(self.src, self.at)
            Some(MsgBool(b)) => Ok(b)
            _                => Err(DeserializeError { path: self.path, reason: "expected a bool" })

    // The integer at `at`, from any of the signed or unsigned formats
    // that fit a signed 64-bit value.
    //
    // A `uint 64` above 2^63 is a `DeserializeError` rather than a
    // negative number: the trait's one integer hook has nowhere to put
    // the bit pattern, and a caller who needs it reads the document
    // with `mpack` instead.
    fn get_int(self) -> Result<Int, DeserializeError>
        match value_at(self.src, self.at)
            Some(MsgInt(n))  => Ok(n)
            Some(MsgUint(_)) => Err(DeserializeError { path: self.path,
                reason: "an unsigned integer above 2^63 does not fit an Int" })
            _                => Err(DeserializeError { path: self.path, reason: "expected an integer" })

    // The float at `at`, from either width.
    fn get_float(self) -> Result<Float, DeserializeError>
        match value_at(self.src, self.at)
            Some(MsgFloat64(f)) => Ok(f)
            Some(MsgFloat32(f)) => Ok(f)
            _                   => Err(DeserializeError { path: self.path, reason: "expected a float" })

    // The string at `at`.
    //
    // A `bin` is not accepted, even when its bytes are valid UTF-8:
    // the document said it was bytes, and the whole point of the family
    // split is that a reader does not have to guess.
    fn get_str(self) -> Result<Str, DeserializeError>
        match value_at(self.src, self.at)
            Some(MsgStr(t)) => Ok(t)
            _               => Err(DeserializeError { path: self.path, reason: "expected a str" })

    fn fail(self, reason: Str) -> DeserializeError
        DeserializeError { path: self.path, reason: reason }

// Write any serializable value as MessagePack bytes.
//
// The one call the trait surface exists for.  It answers a `Result`
// only for the depth limit — a type that nests deeper than a decoder
// will read — because every other member the walk can present has an
// encoding here.
//
// ```novo
// use std.bytes
// use mpackserde
//
// struct Reading
//     sensor: Int
//     celsius: Float
//
// fn main() [io]
//     match mpackserde.to_bytes(Reading { sensor: 3, celsius: 21.5 })
//         Ok(b)  => println(bytes.to_hex(b))
//         Err(e) => println(e.message())
// ```
pub fn to_bytes<T: Serialize>(v: T) -> Result<Bytes, MsgError>
    let b = writer_bytes(v.serialize(writer()))
    match mpack.decode_prefix(b)
        Err(e) => Err(e)
        Ok(_)  => Ok(b)

// Read MessagePack bytes back into any deserializable type.
//
// `T` is named by nothing but the result, so the call has to sit where
// the type is known — a binding with an annotation, or a return
// position.  The error is the standard library's `DeserializeError`
// rather than this package's, because that is what the trait returns
// and a walk forty members deep is exactly the case its `path` is for.
//
// Bytes left over are not an error here: a caller decoding one message
// from one buffer checks `reader_at` against the buffer's length, and a
// caller reading a stream wants `mpackdec`.
//
// ```novo
// use std.bytes
// use mpackserde
//
// struct Reading
//     sensor: Int
//     celsius: Float
//
// fn main() [io]
//     let raw = bytes.from_hex("82a673656e736f7203a763656c73697573cb4035800000000000") ?? bytes.zeros(0)
//     let r: Result<Reading, DeserializeError> = mpackserde.from_bytes(raw)
//     match r
//         Ok(x)  => println("${x.sensor}")
//         Err(e) => println(e.message())
// ```
pub fn from_bytes<T: Deserialize>(src: Bytes) -> Result<T, DeserializeError>
    T.deserialize(reader(src))

// The writer with `more` appended to its document.
fn wrote(w: MsgWriter, more: [Int]) -> MsgWriter
    MsgWriter { out: list.concat(w.out, more), depth: w.depth }

// The writer one level deeper or shallower.
fn deeper(w: MsgWriter, by: Int) -> MsgWriter
    MsgWriter { out: w.out, depth: w.depth + by }

// A value's encoding as a list of byte values.
fn encoded(v: mpack.MsgValue) -> [Int]
    bytes.to_byte_list(mpack.encode(v))

// An array or map header for `n` entries: the fix form below 16, then
// 16 and 32 bits.
fn header(n: Int, fix: Int, wide: Int) -> [Int]
    if n < 16
        return [fix | n]
    if n <= 0xFFFF
        return [wide, n >>> 8, n & 0xFF]
    [wide + 1, (n >>> 24) & 0xFF, (n >>> 16) & 0xFF, (n >>> 8) & 0xFF, n & 0xFF]

// One byte of the document, or -1 past its end.
fn byte(src: Bytes, at: Int) -> Int
    bytes.byte_at(src, at) ?? -1

// The value at `at`, decoded, or `None` when it does not decode.
fn value_at(src: Bytes, at: Int) -> ?mpack.MsgValue
    if at < 0 or at >= bytes.len(src)
        return None
    match mpack.decode_prefix(bytes.slice(src, at, bytes.len(src)))
        Ok(p)  => Some(p.value)
        Err(_) => None

// The offset after the value at `at`, or the end of the document when
// it does not decode.
fn skip(src: Bytes, at: Int) -> Int
    let n = bytes.len(src)
    if at < 0 or at >= n
        return n
    match mpack.decode_prefix(bytes.slice(src, at, n))
        Ok(p)  => at + p.consumed
        Err(_) => n

// A big-endian count of `width` bytes after the format byte at `at`.
fn count_at(src: Bytes, at: Int, width: Int) -> Int
    list.fold(list.range(at + 1, at + 1 + width), (n, i) => n * 256 + (bytes.byte_at(src, i) ?? 0), 0)

// How many entries the map at `at` has, 0 when it is not a map.
fn map_count(src: Bytes, at: Int) -> Int
    let tag = byte(src, at)
    if tag >= 0x80 and tag <= 0x8F
        return tag & 0x0F
    if tag == 0xDE
        return count_at(src, at, 2)
    if tag == 0xDF
        return count_at(src, at, 4)
    0

// Where the entries of the map at `at` begin.
fn map_body(src: Bytes, at: Int) -> Int
    let tag = byte(src, at)
    at + (if tag == 0xDE then 3 else (if tag == 0xDF then 5 else 1))

// How many elements the array at `at` has.
fn seq_count(src: Bytes, at: Int) -> Int
    let tag = byte(src, at)
    if tag == 0xDC
        return count_at(src, at, 2)
    if tag == 0xDD
        return count_at(src, at, 4)
    tag & 0x0F

// Where the elements of the array at `at` begin.
fn seq_body(src: Bytes, at: Int) -> Int
    let tag = byte(src, at)
    at + (if tag == 0xDC then 3 else (if tag == 0xDD then 5 else 1))

// The offset of the value whose key is the string `name` in the map at
// `at`, the first such when there are several.
fn member_at(src: Bytes, at: Int, name: Str) -> ?Int
    var key = map_body(src, at)
    for _ in 0..map_count(src, at)
        let value = skip(src, key)
        if let Some(MsgStr(k)) = value_at(src, key)
            if k == name
                return Some(value)
        key = skip(src, value)
    None
